# AI Career Coach Configuration Settings

# FastAPI Server configuration
PORT=8000
FRONTEND_URL=http://localhost:5173

# MongoDB configuration (Atlas Connection URI)
# Substitute <username> and <password> with your database user credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/ai_career_coach?retryWrites=true&w=majority
DATABASE_NAME=ai_career_coach

# Security settings (Run `openssl rand -hex 32` or type a secure random string)
JWT_SECRET=super_secret_jwt_signature_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# IBM Watsonx/Granite credentials (Leave empty or fill to use IBM Granite. If empty, local stubs will be used)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
